# ============================================================================
# Campus Kitchen - environment contract
# Copy to `.env` and fill in. NEVER commit a real .env.
# Generate every secret with: openssl rand -base64 48
# ============================================================================

NODE_ENV=development
TZ=Asia/Kolkata

# ---------------------------------------------------------------- API runtime
API_PORT=4000
API_URL=http://localhost:4000
API_GLOBAL_PREFIX=api

# Comma-separated exact origins. Wildcards are rejected at boot.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Cookie domain shared by all portals. Leave empty for localhost.
# Production: .campuskitchen.in
COOKIE_DOMAIN=
# Number of trusted reverse proxies in front of the API (nginx/Cloudflare).
TRUST_PROXY_HOPS=1

# Baseline throttle applied to every route; auth and checkout have tighter limits.
# Keyed by IP, and a campus shares a handful of NAT addresses, so this ceiling has to
# accommodate a whole hostel browsing at dinner time. Abuse is caught by the tight
# per-route limits (login, checkout), not by this one.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# ------------------------------------------------------------------- Database
# Local: single-node replica set from docker-compose (transactions required).
MONGODB_URI=mongodb://localhost:27018/campus_kitchen?replicaSet=rs0&directConnection=true
# Production example (TLS + SCRAM enforced):
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/campus_kitchen?retryWrites=true&w=majority&tls=true

# ---------------------------------------------------------------------- Redis
REDIS_URL=redis://localhost:6380
REDIS_PASSWORD=localdevpassword
REDIS_TLS=false

# ------------------------------------------------------------------------ Auth
# Two independent secrets: leaking the access secret must not mint refresh tokens.
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=campus-kitchen
JWT_AUDIENCE=campus-kitchen-clients

# Pepper mixed into password hashing; rotating it invalidates all passwords.
PASSWORD_PEPPER=replace-me-with-openssl-rand-base64-32

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
# Restrict signups to campus email domains. Empty = allow any.
AUTH_ALLOWED_EMAIL_DOMAINS=

# ------------------------------------------------------------------- Payments
# razorpay | mock
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -------------------------------------------------------------------- Storage
# Amazon S3 (not MinIO). Leave S3_ENDPOINT empty so the SDK uses AWS for S3_REGION.
# IAM user needs s3:PutObject, s3:DeleteObject, s3:GetObject on this bucket.
# Public read is via bucket policy on kitchen/*, menus/*, avatars/*, reviews/*, banners/*.
# documents/* stays private. Block Public ACLs; do not enable object ACLs.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=campus-kitchen-media
S3_ACCESS_KEY_ID=replace-with-iam-access-key
S3_SECRET_ACCESS_KEY=replace-with-iam-secret
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=https://campus-kitchen-media.s3.ap-south-1.amazonaws.com

# Origin the kitchen/admin browser PUTs a presigned upload to. Optional: Next derives
# it from S3_BUCKET / S3_REGION / S3_PUBLIC_BASE_URL. Set this if the PUT host differs
# from those (a custom CDN does not receive PUTs).
# NEXT_PUBLIC_UPLOAD_ORIGIN=https://your-bucket.blr1.digitaloceanspaces.com

# ----------------------------------------------------------------------- Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Campus Kitchen <no-reply@campuskitchen.in>"

# ------------------------------------------------------- Push (Firebase FCM)
# Service account for the Admin SDK. Store as a single-line JSON string or a
# path to a mounted secret file. Never check the file into git.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------ SMS
# msg91 | mock
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=

# ------------------------------------------------------------------ Frontends
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
# Quoted because it contains a space: a bare value breaks `source .env` in a shell.
NEXT_PUBLIC_APP_NAME="Campus Kitchen"

# The campus a customer deployment serves. One value per domain: a campus is a tenant,
# and anonymous requests resolve it from the slug the browser sends.
NEXT_PUBLIC_CAMPUS_SLUG=iit-kharagpur

# Shown to a rider in the delivery portal when a handover locks after too many wrong
# codes - the one situation the app cannot resolve on its own.
NEXT_PUBLIC_SUPPORT_PHONE=

# Firebase web config (public by design - these are not secrets)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
